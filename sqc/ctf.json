    "title": "Doki Doki Literature Club (Ren'Py)",
    "flags": [
      {"name": "the music and voice tracks out of the RPA archives", "glob": "ogg/*.ogg", "min": 10},
      {"name": "character sprites and backgrounds", "glob": "png/*.png", "min": 100},
      {"name": "the game scripts decompiled to .rpy", "glob": "rpy/*.rpy", "min": 10}
    ]
  },
